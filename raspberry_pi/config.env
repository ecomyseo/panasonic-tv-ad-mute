# Configuración del Panasonic TV Hub (Raspberry Pi)
# En la Raspberry se edita en /etc/panasonic-tv-hub/config.env  (sudo nano /etc/panasonic-tv-hub/config.env)
# Después de cambiar algo:  tvhub reiniciar

# --- Televisión -----------------------------------------------------------
# IP de la TV (puerto ADB 5555). Conviene fijarla en el router (DHCP estático).
TV_IP=192.168.1.132:5555
# MAC de la TV para encenderla por la red (Wake-on-LAN). Vacío = no se usa.
TV_MAC=

# --- Silenciador automático de publicidad --------------------------------
# Segundos que se quita el sonido al detectar un corte publicitario
MUTE_DURATION=150
# Segundos tras devolver el sonido en los que se ignoran nuevos marcadores
COOLDOWN_SECONDS=30
# Textos del logcat de la TV que marcan el inicio de la publicidad (separados por comas).
# Vacío = solo se silencia con el botón del móvil. OJO: «exchangeType==28» y «getHBBTVBannerControl»
# NO sirven: la TV los escribe cada 30 s haya anuncios o no (se ignoran aunque estén aquí).
AD_PATTERNS=
# Textos del logcat que marcan el FINAL de la publicidad (vacío = no se detecta el final)
AD_END_PATTERNS=
# 1 = si cambias de canal durante los anuncios, la TV vuelve sola al canal donde empezaron
VOLVER_AL_CANAL=1
# Segundos que se calcula que dura un corte mientras no se haya medido ninguno en ese canal
# (luego se usa lo que han durado de verdad los últimos cortes de cada canal)
DURACION_PUBLI=300

# --- Avisos en la pantalla y recordatorios ------------------------------------
# 1 = avisos encima de lo que estés viendo («Vuelvo a Antena 3 en 30 s»). Los pinta la app
# «TV Hub Avisos», que se instala sola con el botón «Preparar avisos» del mando web.
AVISOS_EN_TV=1
# Segundos que se ve cada aviso
AVISOS_DURACION=8
# Tamaño de la letra del título del aviso (18 a 96; 40 se lee bien a 3 metros)
AVISOS_TAMANO=40
# Dónde sale el aviso: centro, arriba o abajo
AVISOS_POSICION=centro
# Solo si usas TvOverlay en lugar de la app propia: su dirección (vacío = la IP de la TV, puerto 5001)
TVOVERLAY_URL=
# 1 = al cambiar de canal, la ficha de lo que echan (una vez por programa; si zapeas rápido, no sale)
FICHA_AL_CAMBIAR=1
# Segundos en el canal antes de enseñarla, y segundos que se ve
FICHA_ESPERA=3
FICHA_SEGUNDOS=10
# 1 = el hub hace de DNS antirrastreo de la tele y apunta qué bloquea y en qué canal (página /privacidad).
# En la tele: DNS 1 = la IP de la Raspberry, DNS 2 = la del router. Y quitar el DNS privado de AdGuard.
DNS_ACTIVO=0
DNS_PUERTO=53
# DNS de verdad al que se pregunta lo que no se bloquea
DNS_SUPERIOR=1.1.1.1
# Señal de la guía (la cadena reenvía el «ahora» del canal: puede ser el corte de anuncios, SIN confirmar).
# 0 = solo se apunta junto a tus pulsaciones de «Silenciar» (el mando enseña cuántas coinciden);
# 1 = silencia con ella. También se cambia con el botón «Silenciar con la señal» del mando web.
GUIA_SILENCIA=0
# Segundos tras cambiar de canal en que no cuenta (la TV pide la guía del canal nuevo)
GUIA_TRAS_ZAPEO=20
# Segundos de guía quieta para dar por empezado un corte nuevo
GUIA_CALMA=480
# Segundos antes de que empiece el programa en que salta un recordatorio
RECORDATORIO_ANTELACION=60
# Etiquetas del logcat que se escuchan (la del canal sirve para saber qué se está viendo)
LOGCAT_TAGS=MtkTvHBBTVBase:D,AUDIO_AMP:W,MtkTvChannelList_jni:D
# 1 = guarda todo lo que la TV escribe en esas etiquetas en /var/lib/panasonic-tv-hub/aprendizaje.log
#     (sirve para comprobar qué línea aparece justo cuando empiezan los anuncios)
MODO_APRENDIZAJE=0

# --- Apagado nocturno -----------------------------------------------------
# Hora (HH:MM) a la que se apaga la TV si sigue encendida. Vacío = desactivado. Ejemplo: 01:30
APAGADO_NOCTURNO=

# --- Mando web ------------------------------------------------------------
WEB_PORT=8080
# El mando solo atiende a este equipo y a la red de casa. Si lo abres con un nombre con puntos que no
# termine en .local, .lan o .home (por ejemplo tele.midominio.es), añádelo aquí separado por comas.
WEB_NOMBRES_PERMITIDOS=

# --- Guía de programación y fichas ---------------------------------------
EPG_URL=https://raw.githubusercontent.com/davidmuma/EPG_dobleM/master/guiatv_sincolor.xml.gz
EPG_HORAS_REFRESCO=4
# Clave gratuita de https://www.themoviedb.org/settings/api para notas y carátulas de TMDb.
# Vacío = se usan la nota y la imagen de la guía, y Wikipedia para las búsquedas.
TMDB_API_KEY=
