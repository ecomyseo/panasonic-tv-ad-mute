[Unit]
Description=Panasonic TV Hub - silenciador automático de publicidad
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USUARIO@
WorkingDirectory=@DESTINO@
Environment=PYTHONUNBUFFERED=1
StateDirectory=panasonic-tv-hub
ExecStart=/usr/bin/python3 @DESTINO@/raspberry_pi/panasonic_ad_mute.py
Restart=always
RestartSec=10
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
