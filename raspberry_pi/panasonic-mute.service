[Unit]
Description=Panasonic Google TV Ad-Mute Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/panasonic-tv-ad-mute/raspberry_pi
ExecStart=/usr/bin/python3 /opt/panasonic-tv-ad-mute/raspberry_pi/panasonic_ad_mute.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
